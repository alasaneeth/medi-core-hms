@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🏥 MediCore HMS — Dashboard</h5>
                </div>
                <div class="card-body">
                    <h4>Welcome, @ViewBag.Name! 👋</h4>
                    <p class="text-muted">Role: <strong>@ViewBag.Role</strong></p>
                    <hr />
                    <p>You are successfully logged in to MediCore HMS.</p>
                    <form asp-action="Logout" asp-controller="Auth" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>